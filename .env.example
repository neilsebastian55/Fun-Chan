# Copy this file to .env and fill it in. Never commit .env.
DISCORD_TOKEN=your-bot-token-here
GUILD_ID=123456789012345678
TIMEZONE=America/Chicago

# Optional: one pinned leaderboard the bot keeps up to date
STANDINGS_CHANNEL_ID=

# Optional: deadline reminders
REMINDER_CHANNEL_ID=
REMIND_HOURS_BEFORE=24

# Optional: birthday announcements, posted once a day at BIRTHDAY_HOUR (0-23, in TIMEZONE)
BIRTHDAY_CHANNEL_ID=
BIRTHDAY_HOUR=9
